# Impede listagem de diretórios
Options -Indexes

# Bloqueia acesso direto a includes/
<IfModule mod_alias.c>
    RedirectMatch 403 ^/includes/
    RedirectMatch 403 ^/Config/
</IfModule>

# Esconde arquivos ocultos e de configuração sensíveis
<FilesMatch "^(config\.php|\.env|\.git|schema_referencia\.sql)$">
    Require all denied
</FilesMatch>
