# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=pangya
POSTGRES_USER=pangya
POSTGRES_PASSWORD=pangya
DATABASE_URL=jdbc:postgresql://localhost:5432/pangya
DATABASE_USER=pangya
DATABASE_PASSWORD=pangya
REDIS_URI=redis://localhost:6379
PANGYA_MIGRATE_ON_START=true
# Public IP (or hostname the JP client can resolve) advertised in the Login server list.
# Leave 127.0.0.1 for a client on the same host. For a remote client set the host LAN/WAN IP.
PANGYA_IP=127.0.0.1
